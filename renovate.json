{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate only bumps the native-tool pins in src/tools.js (Dependabot handles npm + actions).",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src/tools\\.js$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n(?:\\s*//.*\\n)*\\s*'?[\\w-]+'?: '(?<currentValue>[^']+)'"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["aquasecurity/trivy"],
      "allowedVersions": "!/^0\\.69\\.4$/"
    },
    {
      "matchDepNames": ["typescript"],
      "allowedVersions": "<6.1.0",
      "description": "typescript-eslint/sonarjs peer range"
    }
  ]
}
