{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.star/run lint:*)",
      "Bash(.star/run format:*)",
      "Bash(.star/run test:*)",
      "Bash(.star/run check:*)",
      "Bash(.star/run build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git commit --no-verify:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ ! -x /opt/agent-guard/bin/agent-guard ]; then echo 'agent-guard is unavailable: ask the host administrator to install the reviewed isolated runner at /opt/agent-guard/bin/agent-guard; no checkout fallback is permitted.' >&2; exit 127; fi; exec /opt/agent-guard/bin/agent-guard check post-edit"
          }
        ]
      }
    ]
  }
}
