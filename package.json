{
  "name": "@susanbeasles/star-config",
  "version": "0.2.0",
  "description": "Shared formatting, lint, test, build and audit tooling with automatic project initialization.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "star-config": "./bin/star-config.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./eslint": "./configs/eslint.config.mjs",
    "./prettier": "./configs/prettier.config.mjs",
    "./biome": "./configs/biome.json",
    "./lint-staged": "./src/lint-staged.js",
    "./configs/*": "./configs/*",
    "./package.json": "./package.json",
    "./vitest": "./configs/vitest.config.mjs"
  },
  "files": [
    "bin",
    "src",
    "configs",
    "LICENSE"
  ],
  "scripts": {
    "lint": "node bin/star-config.js lint",
    "lint:fix": "node bin/star-config.js lint --fix",
    "format": "node bin/star-config.js format",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "node bin/star-config.js audit",
    "check": "node bin/star-config.js check",
    "build:sea": "node scripts/build-sea.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build": "node scripts/build-package.mjs",
    "postinstall": "node bin/postinstall.js",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "release:plan": "node scripts/release-plan.mjs"
  },
  "dependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint-react/eslint-plugin": "5.26.7",
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "smol-toml": "1.9.1",
    "typescript-eslint": "8.71.2",
    "yaml": "2.9.1",
    "vitest": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "6.0.3",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "postject": "1.0.0-alpha.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "lint",
    "format",
    "eslint",
    "prettier",
    "biome",
    "ruff",
    "vitest",
    "playwright",
    "pytest",
    "gitleaks",
    "trivy",
    "semgrep",
    "cdk-nag",
    "husky",
    "lint-staged",
    "devcontainer",
    "mise"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susanbeasles/star-config.git"
  },
  "private": true
}
