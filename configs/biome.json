{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": false,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/.next",
      "!**/*.min.js",
      "!**/*.min.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "useMaxParams": {
          "level": "warn",
          "options": { "max": 5 }
        },
        "noUselessCatch": "error",
        "noUselessStringConcat": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "warn"
      },
      "security": {
        "noSecrets": "error",
        "noGlobalEval": "error",
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "useConst": "error",
        "useBlockStatements": "error",
        "noParameterAssign": "error",
        "noNonNullAssertion": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": { "allow": ["warn", "error"] }
        },
        "noDebugger": "error",
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
        "noDoubleEquals": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.*", "**/*.spec.*", "**/test/**", "**/tests/**", "**/__tests__/**"],
      "linter": {
        "domains": { "test": "recommended" },
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" },
          "security": { "noSecrets": "warn" },
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noConsole": "off", "noExplicitAny": "warn" }
        }
      }
    },
    {
      "includes": ["**/bin/**", "**/scripts/**", "**/cli/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    }
  ]
}
